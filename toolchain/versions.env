# Everything the toolchain pins. Change a value here, then rerun toolchain/build.sh.

# Angular commit that ngp is built from. 92e5aa8 is the commit behind 22.3.0-next.2.
ANGULAR_SHA=92e5aa8f154096a756757d0e295cde4299788650

# npm packages built from ANGULAR_SHA. The TS backend imports their private APIs,
# so this must match the commit above.
ANGULAR_NPM_VERSION=22.3.0-next.2

# Rust toolchain for all three engines. Matches the Homebrew cargo this was first
# built with; the wasm target needs rustup, so the build installs it locally.
RUST_TOOLCHAIN=1.96.0

# Must equal the wasm-bindgen crate version in Angular's Cargo.lock (Cargo.toml pins =0.2.121).
WASM_BINDGEN_VERSION=0.2.121

# Benchmark runner, installed with the local Cargo into toolchain/.cache/tools.
# 2.0.0 needs rustc 1.97; 1.20.0 is the newest that builds with RUST_TOOLCHAIN.
HYPERFINE_VERSION=1.20.0
