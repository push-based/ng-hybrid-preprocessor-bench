+/**
+ * Opt-in phase timings for benchmarking (ng-hybrid-preprocessor-bench patch).
+ * Enabled by NGP_PHASE_TIMINGS=<file>; all values are milliseconds of wall time.
+ *
+ * The chunk-level phases are disjoint and run one after another, so together they cover
+ * `run()`. `codegenSum` adds up each file's `compiler.processFile` call; files in a chunk are
+ * processed concurrently, so it can include time a file spent waiting on another's I/O.
+ */
+export const phaseTimings = process.env['NGP_PHASE_TIMINGS']
+  ? {
+      file: process.env['NGP_PHASE_TIMINGS'],
+      mainStart: 0, // process start -> main() starts: Node bootstrap + module loading
+      setup: 0, // config reading, analyzer construction, HybridCompiler construction
+      analyzerWait: 0, // blocked waiting for the analyzer's next chunk
+      prepareChunk: 0,
+      processFiles: 0, // read, generate and write every file in each chunk
+      writeDiagnostics: 0,
+      codegenSum: 0,
+      chunks: 0,
+      files: 0,
+    }
+  : null;
+
