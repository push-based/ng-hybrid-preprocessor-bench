// Compiles ngp's TypeScript backend outside Bazel, against the npm packages
// built from the same Angular commit. Options mirror packages/tsconfig-build.json.
{
  "compilerOptions": {
    "rootDir": ".cache/angular/packages/compiler-cli/preprocessor",
    "outDir": "out/preprocessor",
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": ["es2022", "es2024.promise", "dom", "dom.iterable"],
    "types": ["node"],
    "strict": true,
    "noImplicitAny": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "declaration": false
  },
  "include": [
    ".cache/angular/packages/compiler-cli/preprocessor/*.ts",
    ".cache/angular/packages/compiler-cli/preprocessor/src/**/*.ts",
    ".cache/angular/packages/compiler-cli/preprocessor/test/utils.ts",
    ".cache/angular/packages/compiler-cli/preprocessor/test/golden_cases.ts",
    ".cache/angular/packages/compiler-cli/preprocessor/test/golden_markdown.ts"
  ],
  // serve.ts needs esbuild and the Babel linker; Bazel's ts_project leaves out
  // the same two files.
  "exclude": [
    ".cache/angular/packages/compiler-cli/preprocessor/serve.ts",
    ".cache/angular/packages/compiler-cli/preprocessor/src/diagnostics.ts"
  ]
}
